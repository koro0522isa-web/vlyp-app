{
  "name": "vlyp-desktop-recorder",
  "version": "1.0.0",
  "description": "VLYP Desktop Screen Recorder with AI-powered highlighting",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "electron-builder",
    "start": "electron dist/main.js"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "recordrtc": "^5.6.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "ws": "^8.14.2",
    "axios": "^1.6.0",
    "opencv4nodejs": "^5.6.0",
    "@tensorflow/tfjs-node": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/fluent-ffmpeg": "^2.1.21",
    "@types/ws": "^8.5.5",
    "@types/recordrtc": "^5.6.2",
    "@types/electron": "^1.4.6",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "electron-builder": "^24.6.0",
    "concurrently": "^8.2.0"
  },
  "build": {
    "appId": "com.vlyp.desktop-recorder",
    "productName": "VLYP Desktop Recorder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
